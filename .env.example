# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa

# Medusa (local development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
JWT_SECRET=your-super-secret-jwt-key-change-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3000,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# BFF
PORT=3001
MEDUSA_BACKEND_URL=http://localhost:9000
CORS_ORIGIN=http://localhost:3000

# Storefront
NEXT_PUBLIC_BFF_URL=http://localhost:3001
BFF_INTERNAL_URL=http://localhost:3001
